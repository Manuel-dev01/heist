{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "HEIST_PUBLIC_HOSTS",
    "KITE_X402_PAYTO",
    "KITE_X402_NETWORK",
    "KITE_X402_ASSET",
    "PIEVERSE_FACILITATOR_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
