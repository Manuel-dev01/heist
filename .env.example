# Keep real values only in .env.local. Never commit credentials.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-nano
# Inference remains disabled until a spending allowance is explicitly approved.
HEIST_ALLOW_INFERENCE=false

